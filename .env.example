# Modele de configuration — copier vers .env puis renseigner les valeurs
#   cp .env.example .env
# Le fichier .env n'est jamais versionne : il contient les secrets reels.

# ─── Base de donnees ───────────────────────────────────────
POSTGRES_DB=QuartierLink
POSTGRES_USER=postgres
POSTGRES_PASSWORD=mot_de_passe_a_definir
# Attention : les caracteres speciaux du mot de passe doivent etre
# encodes pour l'URL (par exemple @ devient %40)
DATABASE_URL=postgresql://postgres:mot_de_passe_a_definir@database:5432/QuartierLink?serverVersion=16&charset=utf8

# ─── Application ───────────────────────────────────────────
APP_ENV=prod
# Chaine aleatoire : php -r "echo bin2hex(random_bytes(16));"
APP_SECRET=chaine_aleatoire_a_generer
CORS_ALLOW_ORIGIN=^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$

# ─── Authentification JWT ──────────────────────────────────
# Generer la paire de cles :
#   php bin/console lexik:jwt:generate-keypair
JWT_SECRET_KEY=/var/www/html/config/jwt/private.pem
JWT_PUBLIC_KEY=/var/www/html/config/jwt/public.pem
JWT_PASSPHRASE=passphrase_a_definir

# ─── Chiffrement des messages prives ───────────────────────
# Cle de 32 octets : php -r "echo bin2hex(random_bytes(32));"
MESSAGES_ENCRYPTION_KEY=cle_hexadecimale_a_generer

# ─── Messagerie temps reel ─────────────────────────────────
MQTT_HOST=mosquitto
MQTT_PORT=1883

# ─── Envoi d'emails ────────────────────────────────────────
# En developpement, Mailpit est disponible : smtp://mailer:1025
MAILER_DSN=smtp://utilisateur:mot_de_passe@smtp.example.com:587
DEFAULT_URI=https://exemple.fr
MQTT_USER=backend
MQTT_PASSWORD=a_definir
