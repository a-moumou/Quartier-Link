# Outils locaux
.claude/
.agents/
.postman/
skills-lock.json

# macOS
.DS_Store
**/.DS_Store

# Secrets et configuration locale
# Le .env de la racine alimente docker-compose : il contient les vraies
# valeurs et ne doit jamais etre versionne. Le modele .env.example, lui,
# est suivi par git.
/.env
/.env.local
!/.env.example
docker-compose.override.yml
backend/.env
backend/.env.local
backend/.env.test
backend/config/jwt/*.pem
frontend/.env
frontend/.env.local
frontend/.env.docker

# Dependances et builds
backend/vendor/
backend/var/
frontend/node_modules/
frontend/dist/

# Fichier de mots de passe du broker MQTT : genere par mosquitto_passwd,
# propre a chaque environnement, ne doit jamais etre versionne.
/docker/mosquitto/passwd

# Variables de build du frontend : contiennent les identifiants MQTT
# du navigateur, differents selon l'environnement.
/frontend/.env.production
